# Copy to backend/.env. None of these are needed for demo mode.
# For hosting, scripts/setup-hosting writes the same variables to backend/.env.hosting, and Render gets them from render.yaml (README "Host it").

# AI for the Claude bar: any OpenAI-compatible API (docs/adr/0004, 0006). With none set, keyword rules answer.
# Groq (free): set only AI_API_KEY. The base URL and model default to Groq and openai/gpt-oss-20b.
# Ollama (offline, no key): AI_BASE_URL=http://localhost:11434/v1 and AI_MODEL=qwen3:4b
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# AI limits, kept in memory. Past any of them the keyword rules answer. Keep the site cap under the provider's free quota.
AI_LIMIT_PER_MINUTE=5
AI_LIMIT_PER_DAY=100
AI_LIMIT_SITE_PER_DAY=200

# Sign in with Google (youtube.readonly; docs/adr/0005, 0012). Leave all five empty for demo only.
# Set one and the backend refuses to start until all five are set.
# The OAuth client's authorized redirect URI is APP_URL + /api/auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Encrypts Google refresh tokens at rest: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Where the frontend is served (session cookies are Secure when it's https). Defaults to http://localhost:5173.
APP_URL=
# The server's YouTube Data API v3 key (Google Cloud console > Credentials). Reads uploads and video details,
# cached per channel and shared by every user (docs/adr/0011). Required with the four above.
YOUTUBE_API_KEY=
# Topic searches (search.list) the whole site may start each day, for feeds' topics outside subscriptions.
# Searches are cached per topic and shared; search.list allows 100 calls a day per project. Defaults to 100.
YOUTUBE_SEARCHES_PER_DAY=

# Postgres when hosted; SQLite (backend/yourfeed.db) is used locally when empty. The backend migrates it at startup;
# by hand: cd backend && uv run --env-file .env alembic upgrade head. Neon: the connection string with pooling off.
DATABASE_URL=
