# Copy to backend/.env. None of these are needed for demo mode.

# AI (any OpenAI-compatible API, see docs/adr/0004). Groq's free tier is the default.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=

# Google OAuth for "Sign in with Google" (youtube.readonly, see docs/adr/0005)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Postgres when hosted; SQLite is used locally when empty
DATABASE_URL=
