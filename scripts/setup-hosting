#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1 && tput clear 2>/dev/null; then return 0; fi
  printf '\033[2J\033[3J\033[H'
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else false; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any, with write_env's single
# quotes or a plain dotenv double-quoted value undone.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line value sq="'\\''"; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  value="${line#*=}"
  if [[ "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; value="${value//"$sq"/\'}"
  elif [[ "$value" == \"*\" ]]; then
    value="${value:1:${#value}-2}"
    [[ "$value" == *[\\\$\"]* ]] && return 1   # escapes, $ or ": can't decode safely; ask again
  fi
  printf '%s' "$value"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret), edited
# with Readline. Fails at EOF with no input.
ask() {
  local key="$1" prompt="$2" current input s=$'\001' e=$'\002' p rc=0
  current=$(_existing "$key" || true)
  # Readline needs the colour codes wrapped in \001..\002 to place the cursor.
  p="  $s$BOLD$e$prompt$s$RESET$e "
  [[ -n "$current" ]] && p+="$s$DIM$e[Enter keeps current]$s$RESET$e "
  read -e -r -p "$p" input || rc=1
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input rc=0
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || rc=1
  printf '\n'
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY='VALUE' into ENV_FILE (replaces any existing
# line) and sets $KEY. Idempotent. Creates ENV_FILE at mode 0600; writes through
# a symlink and keeps an existing file's mode.
write_env() {
  local key="$1" value="$2" tmp sq="'\\''"
  [[ -e "$ENV_FILE" ]] || (umask 077 && : > "$ENV_FILE")
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf "%s='%s'\n" "$key" "${value//\'/$sq}" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
  printf -v "$key" '%s' "$value"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# Keep every stage inside run_wizard and the last line as is: bash then parses
# the whole file before the first prompt, so an edit mid-run can't break it.
# ──────────────────────────────────────────────────────────────────────────

# Yourfeed's hosting setup (docs/adr/0014, README "Host it"). Run it from anywhere: scripts/setup-hosting
# It only opens pages, prints what to click and saves what you paste to backend/.env.hosting (git-ignored, mode 0600).

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEFAULT_APP_URL="https://yourfeed.onrender.com"
DEFAULT_API_URL="https://yourfeed-api.onrender.com"
LOCAL_CALLBACK="http://localhost:5173/api/auth/callback"
SCOPE="https://www.googleapis.com/auth/youtube.readonly"

# _clipboard copies stdin to the system clipboard; fails when there's no clipboard tool.
_clipboard() {
  if   command -v pbcopy   >/dev/null 2>&1; then pbcopy
  elif command -v clip.exe >/dev/null 2>&1; then clip.exe
  elif command -v wl-copy  >/dev/null 2>&1; then wl-copy
  elif command -v xclip    >/dev/null 2>&1; then xclip -selection clipboard
  else return 1; fi
}

# hand_over KEY puts a saved value on the clipboard for one paste into Render, without printing it.
hand_over() {
  local key="$1" value="${!1-}"
  if [[ -z "$value" ]]; then
    step "$key: leave it empty."
    return
  fi
  if printf '%s' "$value" | _clipboard >/dev/null 2>&1; then
    pause "$key is on your clipboard. Paste it into Render's $key field, then press Enter."
  else
    warn "No clipboard tool found: copy $key from $ENV_FILE yourself."
    pause "Press Enter once $key is pasted into Render."
  fi
}

# ask_valid KEY "Prompt" PATTERN "Hint" [secret] asks until the answer matches the regex.
ask_valid() {
  local key="$1" prompt="$2" pattern="$3" hint="$4" secret="${5:-}"
  while true; do
    if [[ -n "$secret" ]]; then ask_secret "$key" "$prompt"; else ask "$key" "$prompt"; fi
    [[ "${!key}" =~ $pattern ]] && return
    warn "$hint"
  done
}

run_wizard() {

TOTAL_STAGES=13
ENV_FILE="$ROOT/backend/.env.hosting"

banner "Host Yourfeed: Google, Neon and Render (free tiers)"

# ── 1 ─────────────────────────────────────────────────────────────────────
stage "Before you start"
say "You'll need: a Google account, the repo pushed to your GitHub, and uv installed."
say "Neon and Render both let you sign up with GitHub. Everything here stays on free tiers."
say "Values you paste are saved to $ENV_FILE (git-ignored), so the migration and smoke"
say "steps can use them and a re-run keeps them. Nothing is printed back."
command -v uv >/dev/null 2>&1 || warn "uv isn't on your PATH: install it (https://docs.astral.sh/uv/) before stage 9."
say ""
say "Render names the site after render.yaml's services when the names are free:"
step "frontend: $DEFAULT_APP_URL"
step "backend:  $DEFAULT_API_URL"
note "If Render picks other addresses, stage 12 tells you what to change."
APP_URL="$(_existing APP_URL || echo "$DEFAULT_APP_URL")"
write_env APP_URL "$APP_URL"
pause

# ── 2 ─────────────────────────────────────────────────────────────────────
stage "Google Cloud: a project"
open_url "https://console.cloud.google.com/projectcreate"
step "Name it Yourfeed (no organisation needed) and click Create."
step "Copy its Project ID (shown under the name; it can differ from the name)."
ask_valid GOOGLE_PROJECT "Paste the project ID:" '^[a-z][a-z0-9-]{4,28}[a-z0-9]$' "A project ID is 6–30 lowercase letters, digits and dashes."

# ── 3 ─────────────────────────────────────────────────────────────────────
stage "Google Cloud: turn on the YouTube Data API"
open_url "https://console.cloud.google.com/apis/library/youtube.googleapis.com?project=$GOOGLE_PROJECT"
step "Check the project picker at the top says $GOOGLE_PROJECT."
step "Click Enable on YouTube Data API v3."
pause "Press Enter once it says API Enabled."

# ── 4 ─────────────────────────────────────────────────────────────────────
stage "Google Cloud: OAuth consent screen (testing mode)"
open_url "https://console.cloud.google.com/auth/overview?project=$GOOGLE_PROJECT"
step "Click Get started. App name: Yourfeed. Support email: yours."
step "Audience: External. Contact email: yours. Agree to the policy and Create."
note "Older consoles call this APIs & Services → OAuth consent screen."
pause "Press Enter for scopes."
open_url "https://console.cloud.google.com/auth/scopes?project=$GOOGLE_PROJECT"
step "Add or remove scopes → filter for youtube.readonly → tick $SCOPE → Update → Save."
pause "Press Enter for test users."
open_url "https://console.cloud.google.com/auth/audience?project=$GOOGLE_PROJECT"
step "Leave the publishing status on Testing (ADR 0012: up to 100 named test users)."
step "Test users → Add users: every Google account that will sign in, yours first."
note "Google warns test users the app isn't verified; that's expected."
pause "Press Enter once the test users are saved."

# ── 5 ─────────────────────────────────────────────────────────────────────
stage "Google Cloud: the OAuth client"
open_url "https://console.cloud.google.com/auth/clients/create?project=$GOOGLE_PROJECT"
step "Application type: Web application. Name: Yourfeed."
step "Authorized redirect URIs → Add URI, twice:"
say "    $APP_URL/api/auth/callback"
say "    $LOCAL_CALLBACK"
step "Click Create. Copy the Client ID, then the Client secret (download the JSON too:"
note "  Google may show the secret only once)."
ask_valid GOOGLE_CLIENT_ID "Paste the Client ID:" '\.apps\.googleusercontent\.com$' "A client ID ends in .apps.googleusercontent.com."
write_env GOOGLE_CLIENT_ID "$GOOGLE_CLIENT_ID"
ask_valid GOOGLE_CLIENT_SECRET "Paste the Client secret (hidden):" '^.{10,}$' "That looks too short for a client secret." secret
write_env GOOGLE_CLIENT_SECRET "$GOOGLE_CLIENT_SECRET"

# ── 6 ─────────────────────────────────────────────────────────────────────
stage "Google Cloud: the server's API key"
open_url "https://console.cloud.google.com/apis/credentials?project=$GOOGLE_PROJECT"
step "Create credentials → API key. Copy it."
step "Then Edit API key → API restrictions → Restrict key → tick YouTube Data API v3 → Save."
note "The backend reads uploads and video details with it, cached and shared (ADR 0011)."
ask_valid YOUTUBE_API_KEY "Paste the API key (hidden):" '^[A-Za-z0-9_-]{30,}$' "An API key is about 39 letters, digits, dashes and underscores." secret
write_env YOUTUBE_API_KEY "$YOUTUBE_API_KEY"

# ── 7 ─────────────────────────────────────────────────────────────────────
stage "Yourfeed's own secrets"
say "Two random secrets, made here and never shown: one signs sessions, one encrypts"
say "Google refresh tokens at rest. A re-run keeps them: a new encryption key would"
say "make every stored sign-in unreadable."
SESSION_SECRET="$(_existing SESSION_SECRET || true)"
if [[ -z "$SESSION_SECRET" ]]; then
  SESSION_SECRET="$(uv run --project "$ROOT/backend" python -c 'import secrets; print(secrets.token_urlsafe(32))')"
fi
write_env SESSION_SECRET "$SESSION_SECRET"
TOKEN_ENCRYPTION_KEY="$(_existing TOKEN_ENCRYPTION_KEY || true)"
if [[ -z "$TOKEN_ENCRYPTION_KEY" ]]; then
  TOKEN_ENCRYPTION_KEY="$(uv run --project "$ROOT/backend" python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())')"
fi
write_env TOKEN_ENCRYPTION_KEY "$TOKEN_ENCRYPTION_KEY"
pause

# ── 8 ─────────────────────────────────────────────────────────────────────
stage "Neon: the Postgres database"
open_url "https://console.neon.tech/app/projects"
step "New project. Name: yourfeed. Region: AWS US West (Oregon), next to Render's default."
step "On the project dashboard click Connect, turn Connection pooling OFF, and copy"
step "the connection string (postgresql://…?sslmode=require)."
note "Pooling off: psycopg prepares statements, which Neon's pooled endpoint doesn't keep."
ask_valid DATABASE_URL "Paste the connection string (hidden):" '^postgres(ql)?://.+@.+/.+' "It should start postgresql:// and name a host and a database." secret
write_env DATABASE_URL "$DATABASE_URL"

# ── 9 ─────────────────────────────────────────────────────────────────────
stage "Neon: create the tables"
say "This runs Yourfeed's Alembic migrations against Neon:"
say "    cd backend && uv run --env-file .env.hosting alembic upgrade head"
note "The backend also migrates at startup; running it now proves the connection works."
if confirm "Run the migrations now?"; then
  if (cd "$ROOT/backend" && uv run --env-file .env.hosting alembic upgrade head); then
    printf '  %s✓ database is at the newest migration%s\n' "$GREEN" "$RESET"
  else
    warn "The migration failed: check DATABASE_URL (re-run this wizard to change it)."
    SKIPPED+=("Alembic migrations: cd backend && uv run --env-file .env.hosting alembic upgrade head")
  fi
else
  SKIPPED+=("Alembic migrations: cd backend && uv run --env-file .env.hosting alembic upgrade head")
fi
pause

# ── 10 ────────────────────────────────────────────────────────────────────
stage "Groq: a model for the Claude bar (optional)"
say "Without a key the Claude bar answers with keyword rules. Groq's free tier needs only a key."
AI_API_KEY="$(_existing AI_API_KEY || true)"
if confirm "Set up a Groq key?"; then
  open_url "https://console.groq.com/keys"
  step "Create API Key → name it yourfeed → copy it."
  ask_valid AI_API_KEY "Paste the Groq key (hidden):" '^.{20,}$' "That looks too short for a Groq key." secret
  write_env AI_API_KEY "$AI_API_KEY"
fi

# ── 11 ────────────────────────────────────────────────────────────────────
stage "Render: create both services from render.yaml"
open_url "https://dashboard.render.com/select-repo?type=blueprint"
step "Connect GitHub if asked, pick this repo, Blueprint name: yourfeed."
step "Render reads render.yaml: yourfeed-api (Python) and yourfeed (static site)."
step "It asks once for each secret. Press Enter below for each; it lands on your clipboard."
for key in APP_URL GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET SESSION_SECRET TOKEN_ENCRYPTION_KEY YOUTUBE_API_KEY DATABASE_URL AI_API_KEY; do
  hand_over "$key"
done
printf '' | _clipboard >/dev/null 2>&1 || true
note "Clipboard cleared."
step "Click Apply (Deploy Blueprint) and wait until both services say Live (5–10 minutes)."
pause "Press Enter once both are Live."

# ── 12 ────────────────────────────────────────────────────────────────────
stage "Render: check the addresses"
say "Open each service in Render and copy the address under its name."
ask_valid LIVE_APP_URL "The yourfeed (static site) address:" '^https://[^/]+$' "Like $DEFAULT_APP_URL, with no path."
ask_valid LIVE_API_URL "The yourfeed-api address:" '^https://[^/]+$' "Like $DEFAULT_API_URL, with no path."
if [[ "$LIVE_APP_URL" != "$APP_URL" ]]; then
  warn "The site isn't at $APP_URL, so three things change:"
  step "Render → yourfeed-api → Environment: set APP_URL to $LIVE_APP_URL and save."
  step "Google → Clients → Yourfeed: redirect URI $LIVE_APP_URL/api/auth/callback."
  open_url "https://console.cloud.google.com/auth/clients?project=$GOOGLE_PROJECT"
  write_env APP_URL "$LIVE_APP_URL"
  pause "Press Enter once both are saved."
fi
if [[ "$LIVE_API_URL" != "$DEFAULT_API_URL" ]]; then
  warn "The backend isn't at $DEFAULT_API_URL. In render.yaml, change the /api/* rewrite to:"
  say "    destination: $LIVE_API_URL/api/*"
  step "Commit and push it; Render syncs the Blueprint and redeploys the site."
  pause "Press Enter once that deploy is Live."
fi
note "Free Render services sleep when idle; the first visit can take about a minute."
if command -v curl >/dev/null 2>&1 && curl -fsS --max-time 90 "$APP_URL/api/health" >/dev/null 2>&1; then
  printf '  %s✓ %s/api/health answers through the site%s\n' "$GREEN" "$APP_URL" "$RESET"
else
  warn "$APP_URL/api/health didn't answer: check the yourfeed-api logs in Render."
  SKIPPED+=("Check $APP_URL/api/health answers {\"success\": true, ...}")
fi
pause

# ── 13 ────────────────────────────────────────────────────────────────────
stage "Sign in and smoke-test YouTube"
open_url "$APP_URL"
step "Account menu → Sign in with Google, as one of the test users. Pick a username."
step "Switch to your real catalog and check your subscriptions' videos show up."
ask_valid SMOKE_USERNAME "The username you picked:" '^@?[A-Za-z0-9_.]{3,20}$' "Usernames are 3–20 letters, digits, dots and underscores."
say "This checks that account end to end against the real Google and YouTube APIs:"
say "    cd backend && uv run --env-file .env.hosting python -m scripts.youtube_smoke --username ${SMOKE_USERNAME#@}"
if confirm "Run the smoke test now?"; then
  (cd "$ROOT/backend" && uv run --env-file .env.hosting python -m scripts.youtube_smoke --username "${SMOKE_USERNAME#@}") \
    || SKIPPED+=("A passing smoke test: see its output, fix, then re-run it")
else
  SKIPPED+=("Smoke test: cd backend && uv run --env-file .env.hosting python -m scripts.youtube_smoke --username ${SMOKE_USERNAME#@}")
fi
pause

finish
}

run_wizard "$@"; exit
